{
  "_hinweis": "Vorlage. Beim ersten Start wird daraus automatisch config.json erzeugt. Nur config.json bearbeiten, danach den Server neu starten.",

  "server": {
    "port": 8080,
    "adresse": "0.0.0.0"
  },

  "sicherheit": {
    "zugangsschluessel": "WIRD-BEIM-ERSTEN-START-AUTOMATISCH-ERZEUGT",
